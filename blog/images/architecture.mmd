flowchart LR
    subgraph CONSUMERS["End Users"]
        ANALYST["Fraud Analyst<br/>internal staff"]
        AGENT["Customer Support Agent<br/>customer-facing"]
    end

    subgraph CLIENT["Databricks Apps (OLTP clients)"]
        APPFULL["Fraud Console App<br/>service principal:<br/>pii_full_access"]
        APPMASK["Customer 360 App<br/>service principal:<br/>pii_masked"]
    end

    subgraph SECRETS["Secret Store"]
        AKV["Azure Key Vault<br/>or AWS / GCP KMS"]
        DBSCOPE["Databricks Secret Scope<br/>(AKV / KMS backed)"]
        AKV ==>|backs| DBSCOPE
    end

    subgraph LAKEBASE["Lakebase Postgres (OLTP)"]
        direction TB
        subgraph VAULT["vault schema"]
            DECF["decrypt_full(ct)<br/>SECURITY DEFINER<br/>EXEC: pii_full_access"]
            DECM["decrypt_masked(ct, strategy)<br/>SECURITY DEFINER<br/>EXEC: pii_masked"]
        end
        subgraph APPSCHEMA["my_app schema"]
            BASE[("customers<br/>email_enc, ssn_enc, card_enc<br/>= bytea ciphertext")]
            VFULL["VIEW customers_full<br/>SELECT: pii_full_access"]
            VMASK["VIEW customers_masked<br/>SELECT: pii_masked"]
            VFULL ==>|reads| BASE
            VMASK ==>|reads| BASE
            VFULL ==>|calls| DECF
            VMASK ==>|calls| DECM
        end
    end

    ANALYST ==>|"uses"| APPFULL
    AGENT ==>|"uses"| APPMASK

    APPFULL ==>|"1- fetch CMK"| DBSCOPE
    APPFULL ==>|"2- SET app.cmk"| LAKEBASE
    APPFULL ==>|"3- SELECT"| VFULL

    APPMASK ==>|"fetch CMK"| DBSCOPE
    APPMASK ==>|"SET app.cmk + SELECT"| VMASK

    VFULL -.->|"plaintext"| APPFULL
    VMASK -.->|"a***@acme.com<br/>XXX-XX-1234"| APPMASK

    classDef cipher fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef plain fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef masked fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    classDef vault fill:#e0e7ff,stroke:#4338ca,color:#1e1b4b

    class BASE cipher
    class VFULL plain
    class VMASK masked
    class DECF,DECM,AKV,DBSCOPE vault
